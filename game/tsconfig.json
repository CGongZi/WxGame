{
  "compilerOptions": {
    "target": "ES2015",
    "module": "commonjs",
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "experimentalDecorators": true,
    "moduleResolution": "node",
    "lib": ["ES2015", "DOM"],
    "baseUrl": "./",
    "paths": {
      "cc": ["./node_modules/cc"]
    },
    "skipLibCheck": true
  },
  "include": [
    "assets/scripts/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
